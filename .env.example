# ==============================================================================
# CashFlow-Guardian Environment Configuration
# ==============================================================================

# Google Gemini API Key
# If provided, the AI Advisor will generate real-time generative CFO diagnostics and advice.
# If left empty, the engine automatically uses the deterministic heuristic financial algorithm.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Configuration (Optional: default uses persistent embedded H2 file database)
# To connect to external PostgreSQL / Supabase, uncomment and fill in:
# DB_URL=jdbc:postgresql://localhost:5432/cashflow_guardian
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

